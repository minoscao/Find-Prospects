{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "find-prospects",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
